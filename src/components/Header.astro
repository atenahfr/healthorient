---
<header class="site-header">
  <a href="/" class="logo">HealthOrient</a>
  <nav class="nav">
    <a href="/navigate-care">Navigate Care</a>
    <a href="/coverage">Coverage</a>
    <a href="/health-library">Health Library</a>
    <a href="/programs">Programs</a>
    <a href="/about">About</a>
  </nav>
  <a href="/get-started" class="cta">Get Started</a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .logo {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 20px;
    color: var(--navy);
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 28px;
  }
  .nav a {
    color: var(--navy);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  .nav a:hover {
    color: var(--teal);
  }
  .cta {
    background: var(--teal);
    color: var(--paper);
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }
</style>