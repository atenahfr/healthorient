---
<header class="site-header">
  <a href="/" class="logo">HealthOrient</a>
  <nav class="nav">
    <a href="/navigate-care">Navigate Care</a>
    <a href="/coverage">Coverage</a>
    <a href="/health-library">Health Library</a>
    <a href="/programs">Programs</a>
    <a href="/about">About</a>
  </nav>
  <a href="/get-started" class="cta">Get Started</a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .logo {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 20px;
    color: var(--navy);
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 28px;
  }
  .nav a {
    position: relative;
    color: var(--navy);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    padding-bottom: 4px;
    transition: color 0.15s ease;
  }
  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 2px;
    background: var(--teal);
    transition: width 0.2s ease;
  }
  .nav a:hover {
    color: var(--teal);
  }
  .nav a:hover::after {
    width: 100%;
  }
  .cta {
    background: var(--teal);
    color: var(--paper);
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .cta:hover {
    background: #17636F;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15, 36, 56, 0.15);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav a, .nav a::after, .cta {
      transition: none;
    }
    .cta:hover {
      transform: none;
    }
  }
</style>