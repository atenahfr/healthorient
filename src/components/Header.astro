---
---
<header class="site-header">
  <a href="/" class="logo">
    <img src="/logo-icon.png" alt="" class="logo-mark" />
    HealthOrient
  </a>
  <div class="right-group">
    <nav class="nav">
      <a href="/navigate-care">Navigate Care</a>
      <a href="/coverage">Coverage</a>
      <a href="/health-library">Health Library</a>
      <a href="/programs">Programs</a>
      <a href="/about">About</a>
    </nav>
    <span class="flag-badge" title="Ontario, Canada">
      <svg class="flag-icon" viewBox="0 0 60 30" width="28" height="14" role="img" aria-label="Canada flag">
        <rect width="60" height="30" fill="#FFFFFF" />
        <rect width="15" height="30" fill="#D80621" />
        <rect x="45" width="15" height="30" fill="#D80621" />
        <path fill="#D80621" d="M30,3 28,9 22,7 23,11 18,14 24,14 23,18 29,16 28,23 30,20 32,23 31,16 37,18 36,14 42,14 37,11 38,7 32,9 Z" />
        <path fill="#D80621" d="M29,19 L31,19 L30,27 Z" />
      </svg>
    </span>
    <a href="/get-started" class="cta">Get Started</a>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 20px;
    color: var(--navy);
    text-decoration: none;
  }
  .logo-mark { height: 28px; width: auto; }
  .right-group { display: flex; align-items: center; gap: 32px; }
  .nav { display: flex; gap: 28px; }
  .nav a {
    position: relative;
    color: var(--navy);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    padding-bottom: 4px;
    transition: color 0.15s ease;
  }
  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 2px;
    background: var(--teal);
    transition: width 0.2s ease;
  }
  .nav a:hover { color: var(--teal); }
  .nav a:hover::after { width: 100%; }
  .flag-badge {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    line-height: 0;
  }
  .cta {
    background: var(--teal);
    color: var(--paper);
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .cta:hover {
    background: #17636F;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15, 36, 56, 0.15);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav a, .nav a::after, .cta { transition: none; }
    .cta:hover { transform: none; }
  }
</style>