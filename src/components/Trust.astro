<section class="trust">
  <span class="eyebrow">Why HealthOrient</span>
  <p class="statement">We don't provide medical care, we help you find it, faster, in plain language, at no cost.</p>
  <div class="chips">
    <span class="chip">Free, always</span>
    <span class="chip">No referral needed</span>
    <span class="chip">Plain language</span>
  </div>
</section>

<style>
  .trust {
    background: linear-gradient(180deg, rgba(27,122,136,0.06), rgba(47,143,91,0.06));
    padding: 64px 24px;
    text-align: center;
  }
  .eyebrow {
    display: block;
    color: var(--teal);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .statement {
    max-width: 620px;
    margin: 0 auto 28px;
    font-family: 'Fraunces', serif;
    font-size: 24px;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.4;
    text-wrap: balance;
  }
  .chips {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    background: white;
    border: 1px solid var(--line);
    color: var(--navy);
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
  }
</style>