---
const cards = [
  { title: "Free Workshops", desc: "Drop-in sessions on navigating OHIP, finding a family doctor, and understanding your first months in the system.", href: "/programs/workshops", cta: "See upcoming workshops" },
  { title: "Meet the Care Team", desc: "The volunteers and navigators behind HealthOutline; who they are, and how to reach them.", href: "/programs/care-team", cta: "Meet the team" },
];
---
<section class="programs">
  <span class="eyebrow">Community Programs</span>
  <h2>Ways to connect beyond the website</h2>
  <div class="programs-grid">
    {cards.map((c) => (
      <div class="program-card">
        <h3>{c.title}</h3>
        <p>{c.desc}</p>
        <a href={c.href}>{c.cta} →</a>
      </div>
    ))}
  </div>
</section>

<style>
  .programs { background: var(--navy); padding: 80px 24px; text-align: center; }
  .eyebrow {
    display: block; color: var(--green); font-size: 12px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 14px;
  }
  .programs h2 { font-family: 'Fraunces', serif; font-size: 26px; color: var(--paper); margin: 0 0 44px; }
  .programs-grid {
    max-width: 880px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px; text-align: left;
  }
  .program-card {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px; padding: 28px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .program-card:hover { border-color: var(--teal); transform: translateY(-3px); }
  .program-card h3 { font-family: 'Fraunces', serif; font-size: 18px; color: var(--paper); margin: 0 0 10px; }
  .program-card p { font-size: 14px; color: var(--paper); opacity: 0.75; line-height: 1.6; margin: 0 0 16px; }
  .program-card a { color: var(--teal); font-size: 13px; font-weight: 600; text-decoration: none; }
  @media (prefers-reduced-motion: reduce) {
    .program-card { transition: none; }
    .program-card:hover { transform: none; }
  }
</style>