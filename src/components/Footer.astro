<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <img src="/logo-icon.png" alt="" class="footer-mark" />
      <span>HealthOutline</span>
    </div>
    <nav class="footer-links">
      <a href="/navigate-care">Navigate Care</a>
      <a href="/coverage">Coverage</a>
      <a href="/health-library">Health Library</a>
      <a href="/programs">Programs</a>
      <a href="/about">About</a>
    </nav>
  </div>
  <p class="disclaimer">HealthOutline provides free health system navigation and education. We do not provide medical advice, diagnosis, or treatment! For medical emergencies, call 911.</p>
  <p class="copyright">© 2026 HealthOutline. Ontario, Canada.</p>
</footer>

<style>
  .site-footer { background: var(--navy); padding: 56px 40px 40px; }
  .footer-top {
    max-width: 1200px; margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 24px;
    padding-bottom: 32px; border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  .footer-brand { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-weight: 600; font-size: 18px; color: var(--paper); }
  .footer-mark { height: 26px; width: auto; }
  .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
  .footer-links a { color: var(--paper); opacity: 0.75; text-decoration: none; font-size: 14px; transition: opacity 0.15s ease; }
  .footer-links a:hover { opacity: 1; color: var(--teal); }
  .disclaimer { max-width: 1200px; margin: 24px auto 12px; color: var(--paper); opacity: 0.6; font-size: 12.5px; line-height: 1.6; }
  .copyright { max-width: 1200px; margin: 0 auto; color: var(--paper); opacity: 0.45; font-size: 12px; }
</style>